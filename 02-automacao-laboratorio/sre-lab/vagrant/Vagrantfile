# frozen_string_literal: true
require 'json'
root = File.expand_path('..', __dir__)
c = JSON.parse(File.read(File.join(root, 'config', 'lab.yml')))
abort 'Use os scripts do projeto, não Vagrant diretamente.' unless ENV['SRE_LAB_RUN'] == '1'
Vagrant.configure('2') do |config|
  config.vm.box = c.fetch('box')
  config.vm.box_version = c.fetch('box_version')
  config.vm.box_check_update = false
  config.ssh.insert_key = true
  config.vm.synced_folder '.', '/vagrant', disabled: true
  config.vm.boot_timeout = 600
  c.fetch('nodes').each do |name, node|
    config.vm.define name do |vm|
      vm.vm.hostname = name
      vm.vm.network 'private_network', ip: node.fetch('ip'), netmask: '255.255.255.0'
      vm.vm.network 'forwarded_port', guest: 22, host: 2200 + c.fetch('nodes').keys.index(name), host_ip: '127.0.0.1', id: 'ssh', auto_correct: true
      vm.vm.disk :disk, size: "#{node.fetch('disk')}GB", primary: true
      vm.vm.provider 'virtualbox' do |vb|
        vb.name = "#{c.fetch('name')}-#{name}"
        vb.cpus = node.fetch('cpu')
        vb.memory = node.fetch('memory')
      end
    end
  end
end
